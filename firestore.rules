rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Everything for this family lives under /users/{parentUid}/...
    // (the child has no separate Auth identity — his profile is a
    // sub-record here, per the Block 1 decision log). A signed-in user
    // may only read/write their own subtree. No other path is allowed
    // to read or write anything, by default.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
